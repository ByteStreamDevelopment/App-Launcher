# Kopieren nach .env und ausfüllen. .env NIEMALS einchecken.
# Das ERSTE Konto, das sich registriert, wird automatisch Admin.

# Öffentliche Adresse des Servers (für Links in E-Mails, Rechtstexte, Stripe)
PUBLIC_URL=https://apps.nebendahl.eu
# Auf 1 setzen, wenn der Server hinter einem Reverse-Proxy (nginx, Caddy, Traefik) läuft
TRUST_PROXY=1

# --- Betreiber (Pflicht für Impressum & Datenschutz) ------------------------
OPERATOR_NAME=
OPERATOR_STREET=
# PLZ und Ort, z. B. "12345 Musterstadt"
OPERATOR_CITY=
OPERATOR_COUNTRY=Deutschland
OPERATOR_EMAIL=
# empfohlen (schnelle Kontaktaufnahme)
OPERATOR_PHONE=
# nur falls vorhanden
OPERATOR_VAT_ID=
# Verantwortlich nach § 18 Abs. 2 MStV (leer = OPERATOR_NAME)
OPERATOR_RESPONSIBLE=
# optional: Hoster, z. B. "Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen"
OPERATOR_HOSTING=
# optional: E-Mail-Anbieter für den Versand, z. B. "mailbox.org (Heinlein Hosting GmbH, Berlin)"
OPERATOR_MAIL_PROVIDER=
# optional: zuständige Datenschutz-Aufsichtsbehörde
OPERATOR_AUTHORITY=
# 1 = Kleinunternehmer (§ 19 UStG, keine Umsatzsteuer auf Belegen)
KLEINUNTERNEHMER=0

# --- E-Mail (SMTP) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# starttls (Port 587) | ssl (Port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nebendahl.eu

# --- Forgejo -------------------------------------------------------------------
FORGEJO_URL=https://git.nebendahl.eu
# Token mit "read:repository" – nötig für private Repos
FORGEJO_TOKEN=
# 1 = alle Repos mit APK-Release automatisch als (Admin-)Apps übernehmen
FORGEJO_AUTO_IMPORT=1
# optional: nur Repos dieser Benutzer/Organisationen importieren (kommagetrennt)
OWNERS=
# Freigabe für neu importierte Apps: open | code | hidden
DEFAULT_ACCESS=open

# optional: GitHub-Token (höheres Abruf-Limit für Apps mit GitHub-Quelle)
GITHUB_TOKEN=

# --- Bezahlung (optional, Stripe) --------------------------------------------
# Ohne Schlüssel funktionieren kostenpflichtige Apps nur über Freischalt-Codes.
STRIPE_SECRET_KEY=
# Webhook-Endpunkt in Stripe: https://apps.nebendahl.eu/api/stripe/webhook
# Ereignisse: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
CURRENCY=eur

# --- Sonstiges -------------------------------------------------------------------
# maximale APK-Größe beim Upload
MAX_UPLOAD_MB=200
# Diese App wird unter https://apps.nebendahl.eu/download angeboten (ByteDroide selbst)
STORE_APP_ID=
