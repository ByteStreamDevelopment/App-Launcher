# Kopieren nach .env und ausfüllen. .env NIEMALS einchecken.

# Dein Forgejo-Server
FORGEJO_URL=https://git.nebendahl.eu

# Forgejo-Token (Forgejo → Einstellungen → Anwendungen → Token, Recht "read:repository").
# Nötig, damit der Server auch PRIVATE Repos sieht und deren APKs ausliefern kann.
FORGEJO_TOKEN=

# Admin-Konto. Das Admin-Passwort ist bereits als Hash im Server eingebaut –
# hier nur eintragen, wenn du ein ANDERES Passwort willst (Klartext oder Hash).
ADMIN_USERNAME=ProfImpossible
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=scrypt$...   (erzeugen: python3 -c "import store_server as s; print(s.hash_password('NEU'))")

# Optional: nur Repos dieser Benutzer/Organisationen (kommagetrennt). Leer = alle.
OWNERS=

# Freigabe für neu entdeckte Apps: open | code | hidden
DEFAULT_ACCESS=open

# Auf 1 setzen, wenn der Server hinter einem Reverse-Proxy (nginx, Caddy, Traefik) läuft
TRUST_PROXY=0
